# UNYX Workspace - Plantilla de variables de entorno
# Copiar a .env.production (VPS) o .env.development (local) según corresponda.
# NUNCA versionar los archivos .env.production ni .env.development.

# ============================================
# 1. PRODUCCIÓN (VPS Global)
# ============================================
# DATABASE_URL=postgresql://unyx_user:${UNYX_DB_PASSWORD}@postgres-unyx:5432/unyx_workspace
# JWT_SECRET=${JWT_SECRET}
# UNYX_DB_PASSWORD=${UNYX_DB_PASSWORD}
# NODE_ENV=production
# CORS_ORIGIN=https://workspace.unyxsolutions.com
# LOG_LEVEL=warn
# LOGIN_RATE_LIMIT_MAX=10
# REDIS_URL=redis://redis:6379
# VITE_API_URL=/api
# VITE_APP_NAME=UNYX Workspace

# ============================================
# 2. DESARROLLO LOCAL (PostgreSQL local)
# ============================================
# DATABASE_URL=postgresql://unyx_user:unyx_password@localhost:5432/unyx_workspace
# JWT_SECRET=dev_jwt_secret_do_not_use_in_production
# NODE_ENV=development
# CORS_ORIGIN=http://localhost:5173
# LOG_LEVEL=debug
# LOGIN_RATE_LIMIT_MAX=1000
# REDIS_URL=redis://localhost:6379
# VITE_API_URL=http://localhost:3000/api
# VITE_APP_NAME=UNYX Workspace (DEV)

# ============================================
# 3. SECRETOS (NO versionar)
# ============================================
# UNYX_DB_PASSWORD=     # Contraseña del usuario unyx_user en postgres-unyx
# JWT_SECRET=           # Clave JWT (mínimo 32 caracteres)
# SEED_ADMIN_PASSWORD=  # Contraseña inicial del usuario admin (opcional)
