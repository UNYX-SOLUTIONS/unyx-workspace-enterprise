# Web
VITE_APP_NAME=UNYX Workspace
VITE_API_URL=/api

# API
PORT=3000
NODE_ENV=development

# Base de datos (desarrollo en host con `docker compose up -d postgres`)
DATABASE_URL=postgresql://unyx:unyx_password@localhost:5432/unyx_workspace

JWT_SECRET=change_this_in_production
CORS_ORIGIN=http://localhost:5173

# Logs
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379

# Docker Compose (PostgreSQL)
POSTGRES_DB=unyx_workspace
POSTGRES_USER=unyx
POSTGRES_PASSWORD=unyx_password

# Seed (opcional): contraseña del usuario administrador
# SEED_ADMIN_PASSWORD=Admin123!
