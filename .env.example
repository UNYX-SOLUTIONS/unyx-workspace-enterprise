# ============================================
# Variables de DOCKER COMPOSE (raíz del monorepo)
# ============================================
# Estas variables alimentan docker-compose.yml (interpolación ${...}).
# Para desarrollo en host, cada app tiene su propio .env:
#   apps/backend/.env   (ver apps/backend/.env.example)
#   apps/frontend/.env  (ver apps/frontend/.env.example)

# PostgreSQL (se aplican al crear el volumen por primera vez)
POSTGRES_DB=unyx_workspace
POSTGRES_USER=unyx
POSTGRES_PASSWORD=unyx_password

# API en contenedor
JWT_SECRET=change_this_in_production
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Web en contenedor (build arg)
VITE_API_URL=/api
