# UNYX Workspace - Producción (VPS Global)
# NO SUBIR A GIT. Reemplaza los valores de ejemplo por los secretos reales.

# Database (contenedor postgres-unyx en empresa-network)
DATABASE_URL=postgresql://unyx_user:${UNYX_DB_PASSWORD}@postgres-unyx:5432/unyx_workspace_enterprise

# Security
JWT_SECRET=
UNYX_DB_PASSWORD=

# API
NODE_ENV=production
CORS_ORIGIN=https://unyx-workspace.com
LOG_LEVEL=info
LOGIN_RATE_LIMIT_MAX=1000

# Redis (contenedor del proyecto)
REDIS_URL=redis://redis:6379

# Seed (opcional, solo primera vez)
SEED_ADMIN_PASSWORD=

# Frontend (compilado en build time)
VITE_API_URL=/api
VITE_APP_NAME=UNYX Workspace
