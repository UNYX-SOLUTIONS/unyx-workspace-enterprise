generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COMERCIAL
  TECNICO
  CLIENTE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(COMERCIAL)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  nombre    String
  ruc       String   @unique
  email     String?
  telefono  String?
  direccion String?
  ciudad    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  proformas Proforma[]
}

model Product {
  id          String   @id @default(cuid())
  codigo      String   @unique
  nombre      String
  marca       String?
  precio      Decimal  @db.Decimal(12, 2)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       ProformaItem[]
}

model Proforma {
  id          String         @id @default(cuid())
  numero      String         @unique
  fecha       DateTime
  validezDias Int            @default(5)
  notas       String?
  subtotal    Decimal        @db.Decimal(12, 2)
  iva         Decimal        @db.Decimal(12, 2)
  total       Decimal        @db.Decimal(12, 2)
  clientId    String
  cliente     Client         @relation(fields: [clientId], references: [id])
  items       ProformaItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProformaItem {
  id          String   @id @default(cuid())
  cantidad    Decimal  @db.Decimal(12, 2)
  precio      Decimal  @db.Decimal(12, 2)
  descripcion String
  marca       String?
  proformaId  String
  productId   String?
  proforma    Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
}

model Maintenance {
  id          String   @id @default(cuid())
  numero      String   @unique
  estado      String
  diagnostico Json?
  checklist   Json?
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
