generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COMERCIAL
  TECNICO
  CLIENTE
}

enum EstadoProforma {
  BORRADOR
  EMITIDA
  ACEPTADA
  CERRADA
}

enum EstadoMantenimiento {
  EN_REVISION
  EN_MANTENIMIENTO
  FINALIZADO
  ENTREGADO
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole   @default(COMERCIAL)
  proformas    Proforma[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Client {
  id        String      @id @default(cuid())
  nombre    String
  ruc       String      @unique
  email     String?
  telefono  String?
  direccion String?
  ciudad    String?
  estado    String      @default("Activo")
  deletedAt DateTime?
  proformas Proforma[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Product {
  id        String         @id @default(cuid())
  codigo    String         @unique
  nombre    String
  marca     String?
  categoria String?
  precio    Decimal        @db.Decimal(12, 2)
  activo    Boolean        @default(true)
  items     ProformaItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Proforma {
  id             String         @id @default(cuid())
  numero         String         @unique
  sequenceNumber Int            @unique
  fecha          DateTime
  validezDias    Int            @default(30)
  notas          String?
  subtotal       Decimal        @db.Decimal(12, 2)
  iva            Decimal        @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  estado         EstadoProforma @default(BORRADOR)
  clientId       String
  cliente        Client         @relation(fields: [clientId], references: [id])
  createdById    String?
  createdBy      User?          @relation(fields: [createdById], references: [id])
  items          ProformaItem[]
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ProformaItem {
  id          String   @id @default(cuid())
  cantidad    Decimal  @db.Decimal(12, 2)
  precio      Decimal  @db.Decimal(12, 2)
  descripcion String
  marca       String?
  codigo      String?
  proformaId  String
  productId   String?
  proforma    Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
}

model Maintenance {
  id        String              @id @default(cuid())
  numero    String              @unique
  estado    EstadoMantenimiento @default(EN_REVISION)
  diagnostico Json?
  checklist Json?
  notas     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model Sequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}
