# Backend (apps/backend) — entorno de DESARROLLO en host

PORT=3000
NODE_ENV=development

# PostgreSQL (con `docker compose up -d postgres` expone localhost:5432)
DATABASE_URL=postgresql://unyx:unyx_password@localhost:5432/unyx_workspace

# JWT (mínimo 16 caracteres; usar uno fuerte en producción)
JWT_SECRET=change_this_in_production

# Origen permitido para CORS
CORS_ORIGIN=http://localhost:5173

# Logs
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379

# Seed (opcional): contraseña del usuario administrador
# SEED_ADMIN_PASSWORD=Admin123!
